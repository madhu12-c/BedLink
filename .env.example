# Copy to .env.local and fill in. Never commit real keys.

# Supabase (public, safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Login accounts setup (server only, used by `npm run seed:users`; never prefix with NEXT_PUBLIC_)
# Service role / secret key: Supabase dashboard -> Project Settings -> API keys
SUPABASE_SERVICE_ROLE_KEY=
# Password every demo account gets (8+ characters)
DEMO_USER_PASSWORD=

# Sarvam AI voice assistant (server only, never prefix with NEXT_PUBLIC_)
# Get a key at https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Optional overrides (defaults shown)
# SARVAM_STT_MODEL=saaras:v4
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_CHAT_MODEL=sarvam-105b-conversations
# SARVAM_TRANSLATE_MODEL=sarvam-translate:v1
# SARVAM_TTS_SPEAKER=
