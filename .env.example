# BedLink Environment Configuration
# Copy this file to .env.local and fill with your Supabase credentials:
# cp .env.example .env.local

# Supabase Project URL (found in Supabase Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Public API Key (found in Supabase Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
